# LedgerLens Environment Configuration
# ================================

# LLM API Key - Required for investigation agent
# Get from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database path (SQLite file)
DB_PATH=./ledgerlens.db

# API Key for service-to-service auth (simple token)
LEDGERLENS_API_KEY=dev_key_12345

# Application settings
LEDGERLENS_ENV=development